# Copy to .env and adjust. Nothing here is a real secret.

# --- Database ---
# Host port Postgres is published on. Change this if 5432 is already in use
# on your machine; nothing else needs to change except the two URLs below.
POSTGRES_HOST_PORT=5432
# Host ports for the API and the two UIs. Change these if something else on
# your machine already owns them; nothing inside the containers changes.
API_HOST_PORT=8000
CMS_HOST_PORT=5173
VIEWER_HOST_PORT=5174
# Full SQLAlchemy URL. Inside docker-compose the host is the service name `db`.
DATABASE_URL=postgresql+psycopg://peblo:peblo@localhost:5432/peblo
# Separate database used by the test suite. Created and dropped by pytest.
TEST_DATABASE_URL=postgresql+psycopg://peblo:peblo@localhost:5432/peblo_test

# --- Auth ---
# Signing key for JWTs. Generate with: openssl rand -hex 32
# In production this comes from a secret manager, never from a file in the repo.
JWT_SECRET=dev-only-change-me-not-for-production-use
JWT_EXPIRY_HOURS=8
# Credentials for the two seeded accounts. Development values only.
SEED_EDITOR_EMAIL=editor@peblo.test
SEED_EDITOR_PASSWORD=editor-dev-password
SEED_ADMIN_EMAIL=admin@peblo.test
SEED_ADMIN_PASSWORD=admin-dev-password

# --- Storage ---
# One of: local | r2
STORAGE_BACKEND=local
# Filesystem root used when STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage_local
# Public URL prefix that artwork and catalogue keys are appended to
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# --- Cloudflare R2 (only read when STORAGE_BACKEND=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# --- App ---
# Directory holding reference.json, seed_shows.json and assets/
DATA_DIR=./data
# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Frontends (read at build time by Vite) ---
VITE_API_BASE_URL=http://localhost:8000
